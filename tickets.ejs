<!DOCTYPE html>
<html>
<head>
    <title>My Tickets</title>
</head>
<body>

    <h1>All Tickets</h1>

    <% tickets.forEach((ticket) => { %>

        <h3><%= ticket.subject %></h3>
        <p><%= ticket.description %></p>
        <p>Status: <%= ticket.status %></p>

        <hr>

    <% }) %>

</body>
</html>